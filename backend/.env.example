PORT=4000
CORS_ORIGIN=http://localhost:5173

# LiveKit (livekit.yaml içindeki keys ile aynı olmalı)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretdevkeyforlocaluseonly1234567890
LIVEKIT_URL=ws://localhost:7880
# Tarayıcıların bağlandığı adres; boşsa LIVEKIT_URL kullanılır (prod: wss://alanadi/livekit)
LIVEKIT_PUBLIC_URL=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zoomtr
DB_PASSWORD=zoomtrpass
DB_NAME=zoomtr

# Proxy arkasında gerçek istemci IP'si için (Nginx aynı makinedeyse loopback)
TRUST_PROXY=loopback

# SMS (katılımcı OTP doğrulaması) — 'netgsm' veya 'console' (kod loga yazılır, sadece geliştirme)
SMS_PROVIDER=console
NETGSM_USERCODE=
NETGSM_PASSWORD=
# Boşsa hesabın varsayılan başlığı; abone numarasıyla göndermek için başında 0 olmadan: 850XXXXXXX
NETGSM_MSGHEADER=
# SMS gönderilebilecek ülke kodları (virgüllü). Boşsa varsayılan liste (Türkiye + yaygın ülkeler)
SMS_ALLOWED_DIAL_CODES=

# SMS ile giriş yapan üyenin oturum süresi (gün)
MEMBER_SESSION_DAYS=30
# KVKK saklama süresi (gün): yoklama kayıtları bu süre sonunda silinir;
# frontend/src/lib/kvkk.js içindeki ATTENDANCE_RETENTION_DAYS ile aynı olmalı
ATTENDANCE_RETENTION_DAYS=30
